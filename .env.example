DOUYIN_COOKIE=
DOUYIN_USER_AGENT=
DOUYIN_REFERER=https://www.douyin.com/
MAX_VIDEO_SIZE_MB=500
ALLOWED_CDN_HOSTS=365yg.com,douyinvod.com,snssdk.com,zjcdn.com,douyin.com
OUTPUT_DIR=outputs
DOWNLOAD_TIMEOUT_SECONDS=60
QUALITY_CACHE_TTL_SECONDS=1800
CANDIDATE_PROBE_ENABLED=true
CANDIDATE_PROBE_TIMEOUT_SECONDS=1.2
CANDIDATE_PROBE_MAX_CANDIDATES=3
PROFILE_SCAN_PROVIDER=public
PROFILE_SCAN_API_BASE=
PROFILE_SCAN_MAX_PAGES=1
PROFILE_SCAN_COUNT_PER_PAGE=20
PROFILE_BUILD_MAX_ITEMS=10
KEYFRAME_MAX_COUNT=30
KEYFRAME_INTERVAL_SECONDS=1

# AI 自动拆解。默认关闭；官方 OpenAI 建议使用 openai_responses。
# OpenAI-compatible 中转站通常使用 openai_compatible；Anthropic Messages 协议使用 anthropic_compatible。
# WinToken 示例：
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=https://www.wintoken.dev/v1
# LLM_MODEL=gpt-5.5
# WinToken /messages 示例：
# LLM_PROVIDER=anthropic_compatible
# LLM_API_BASE=https://www.wintoken.dev
# LLM_MODEL=claude-fable-5
LLM_PROVIDER=disabled
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2
LLM_MAX_KEYFRAMES=6
LLM_MAX_OUTPUT_TOKENS=1200
LLM_IMAGE_MAX_WIDTH=1280
LLM_IMAGE_JPEG_QUALITY=72

# 本地 ASR。默认关闭；安装 requirements-asr.txt 后可改为 auto。首次运行可能下载 Whisper 模型。
ASR_PROVIDER=disabled
ASR_MODEL_SIZE=base
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=default
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5

# 本地 OCR。默认关闭；安装 requirements-ocr.txt 后可改为 auto。
OCR_PROVIDER=disabled
OCR_LANGUAGE=ch
OCR_MAX_FRAMES=12
OCR_SUBTITLE_CROP_RATIO=0.35

# 本机 Chrome 辅助扫描。
# dedicated：使用 outputs/local_chrome_profile 专用 profile，安全隔离，但首次需要单独登录。
# existing：复用日常 Chrome 用户数据目录，可复用已登录态；使用前请完全退出普通 Chrome，再按页面命令启动调试 Chrome。
LOCAL_CHROME_PROFILE_MODE=dedicated
LOCAL_CHROME_USER_DATA_DIR=
