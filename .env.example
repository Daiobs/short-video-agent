DOUYIN_COOKIE=
MAX_VIDEO_SIZE_MB=500
ALLOWED_CDN_HOSTS=365yg.com,douyinvod.com,snssdk.com,zjcdn.com,douyin.com
OUTPUT_DIR=outputs
DOWNLOAD_TIMEOUT_SECONDS=60
QUALITY_CACHE_TTL_SECONDS=1800
CANDIDATE_PROBE_ENABLED=true
CANDIDATE_PROBE_TIMEOUT_SECONDS=1.2
CANDIDATE_PROBE_MAX_CANDIDATES=3
KEYFRAME_MAX_COUNT=30
KEYFRAME_INTERVAL_SECONDS=1

# AI 自动拆解。默认关闭；官方 OpenAI 建议使用 openai_responses。
# OpenAI-compatible 中转站通常使用 openai_compatible；Anthropic Messages 协议使用 anthropic_compatible。
# WinToken 示例：
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=https://www.wintoken.dev/v1
# LLM_MODEL=gpt-4o
# WinToken /messages 示例：
# LLM_PROVIDER=anthropic_compatible
# LLM_API_BASE=https://www.wintoken.dev/v1
# LLM_MODEL=claude-fable-5
LLM_PROVIDER=disabled
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2
LLM_MAX_KEYFRAMES=6

# 本地 ASR。默认关闭；安装 requirements-asr.txt 后可改为 faster_whisper。
ASR_PROVIDER=disabled
ASR_MODEL_SIZE=base
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=default
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5

# 本地 OCR。默认关闭；安装 requirements-ocr.txt 后可改为 rapidocr。
OCR_PROVIDER=disabled
OCR_LANGUAGE=ch
OCR_MAX_FRAMES=12
OCR_SUBTITLE_CROP_RATIO=0.35
